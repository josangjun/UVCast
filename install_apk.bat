@echo off
chcp 65001 > nul
echo =======================================================
echo              UVCast APK 설치 스크립트
echo =======================================================
echo.
echo 1. 안드로이드 스마트폰의 [설정] - [휴대전화 정보] - [소프트웨어 정보]에서
echo    [빌드 번호]를 7번 연속으로 눌러 개발자 옵션을 활성화하세요.
echo 2. [설정] - [개발자 옵션]에서 [USB 디버깅]을 활성화하세요.
echo 3. 스마트폰을 USB 케이블로 PC에 연결하세요.
echo 4. 스마트폰 화면에 "USB 디버깅을 허용하시겠습니까?" 팝업이 뜨면 [허용]을 누르세요.
echo.
echo 연결이 완료되었다면 아무 키나 눌러 설치를 시작합니다...
pause > nul

echo.
echo [1/2] 연결된 안드로이드 기기 확인 중...
adb devices

echo.
echo [2/2] APK 설치 중... (app-debug.apk)
adb install -r "%~dp0android-project\app\build\outputs\apk\debug\app-debug.apk"

if %errorlevel% equ 0 (
    echo.
    echo =======================================================
    echo           ★ 설치 완료! 앱이 정상적으로 설치되었습니다.
    echo =======================================================
) else (
    echo.
    echo -------------------------------------------------------
    echo  [오류] 설치에 실패했습니다. 다음 사항을 확인해 주세요:
    echo  - 스마트폰이 PC에 올바르게 연결되어 있는가?
    echo  - USB 디버깅이 켜져 있는가?
    echo  - 화면에서 디버깅 권한 허용을 수락했는가?
    echo -------------------------------------------------------
)
echo.
pause

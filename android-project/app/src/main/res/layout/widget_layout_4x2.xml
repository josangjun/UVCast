<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EF1D1D20"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Left Column: Current Status -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_location_4x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="서울 종로구"
            android:textColor="#FFA1A1AA"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_uv_num_4x2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="#FFF97316"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:layout_marginBottom="4dp"
                android:text="UV"
                android:textColor="#FFA1A1AA"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_level_text_4x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="자외선 수준: 높음"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_time_4x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="13:40 업데이트"
            android:textColor="#FF71717A"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- Dividing accent lines -->
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="10dp"
        android:background="#1affffff" />

    <!-- Right Column: Forecast Hours -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.6"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 시간대별 차단 예보"
            android:textColor="#FFA1A1AA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 3 Forecast Columns Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- F1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/f1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12시"
                    android:textColor="#FF71717A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/f1_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주의"
                    android:textColor="#FFF97316"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- F2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/f2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="15시"
                    android:textColor="#FF71717A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/f2_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="보통"
                    android:textColor="#FFFABF2C"
                    android:textSize="8sp" />
            </LinearLayout>

            <!-- F3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/f3_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18시"
                    android:textColor="#FF71717A"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/f3_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="안심"
                    android:textColor="#FF10B981"
                    android:textSize="8sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

</LinearLayout>
